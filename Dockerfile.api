# =============================================================================
# Dockerfile para la LICENSING API (FastAPI/uvicorn) en Render.
# =============================================================================
# Sirve la API de licencias + admin panel + landing publica en /, /admin/*,
# /auth/*, /license/*, /updates/*, /admin/*, /landing-assets/*.
#
# NO incluye Chromium, Playwright, Streamlit, PDFplumber ni el resto del
# stack del bot desktop — es una imagen liviana (~150 MB) que arranca
# en segundos.
#
# Para construir: docker build -f Dockerfile.api -t robot-audit-api .
# En Render: configurar "Dockerfile Path" = ./Dockerfile.api
# =============================================================================

FROM python:3.11-slim AS runtime

# Reducir ruido / mejorar reproducibilidad
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Libs del sistema minimas (solo lo necesario para psycopg2 y SSL).
# Se instalan en una sola capa y se limpian listas de apt al final.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl ca-certificates \
        libssl3 \
        # gcc + libpq-dev solo si bcrypt o cryptography fuerzan compilacion;
        # en Python 3.11 slim normalmente vienen las wheels precompiladas.
        && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Dependencias de Python (capa propia para aprovechar cache de Docker
# entre builds — si requirements no cambia, esta capa se reusa)
COPY licensing_api/requirements.txt /app/requirements-api.txt
RUN pip install --upgrade pip==24.2 setuptools wheel && \
    pip install --no-cache-dir -r /app/requirements-api.txt

# Copiar SOLO la API (no el bot desktop)
COPY licensing_api/ /app/licensing_api/

# El endpoint /manual prioriza la env var MANUAL_URL (e.g., GitHub Releases)
# y solo cae al archivo local como fallback. Por eso NO copiamos
# MANUAL_USUARIO.pdf al contenedor — el manual vive en GitHub Releases.
# Esto permite actualizarlo sin redeploy del Render.

# Usuario no-root para seguridad
RUN groupadd --system --gid 1001 appuser && \
    useradd --system --uid 1001 --gid appuser --shell /sbin/nologin appuser && \
    chown -R appuser:appuser /app

USER appuser

# Render asigna $PORT dinamicamente (suele ser 10000). Si la env no esta
# definida, default a 8000 para builds locales.
ENV PORT=8000
EXPOSE 8000

# Healthcheck: la landing en / es publica, devuelve 200 cuando la app
# esta lista. Render ignora este HEALTHCHECK y usa su propio healthcheck
# basado en healthCheckPath del render.yaml — esto es para builds locales.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://localhost:${PORT}/ || exit 1

# Usar la forma shell para que ${PORT} se expanda.
CMD uvicorn licensing_api.main:app --host 0.0.0.0 --port ${PORT}
