# =============================================================================
#  SRI Robot Audit  —  Plantilla de variables de entorno
# =============================================================================
#  Copiá este archivo a `.env` y completá los valores.
#  Nunca commitees `.env` (está en .gitignore).
#
#  Cada bloque indica el SERVICIO al que aplica:
#    [licensing_api]  → FastAPI (servicio "API" en Render)
#    [app]            → aplicacion.py / Streamlit (servicio "web" en Render)
#    [robot]          → módulo robot/downloader.py (corre dentro de la app)
#    [launcher]       → desktop_launcher.py (build de escritorio .exe)
#    [scripts]        → herramientas de release (publish_update, manage_licenses)
#
#  Generar secretos seguros:
#    python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================


# -----------------------------------------------------------------------------
#  Auth & Seguridad  [licensing_api]
# -----------------------------------------------------------------------------

# REQUERIDO. Clave para firmar JWTs. Mínimo 32 chars. Sin este valor la API
# no arranca (ver licensing_api/security.py). NUNCA reutilizar el valor entre
# entornos (dev/staging/prod) ni compartirlo.
LICENSE_API_SECRET=

# Algoritmo de firma JWT. HS256 es lo recomendado.
LICENSE_API_ALGORITHM=HS256

# Tiempo de vida de los tokens JWT en minutos.
LICENSE_TOKEN_EXPIRE_MINUTES=60


# -----------------------------------------------------------------------------
#  Panel administrativo /admin  [licensing_api]
# -----------------------------------------------------------------------------
# Credenciales para acceder al panel web de administración en /admin.
# Permite gestionar usuarios y licencias desde una interfaz HTML simple
# en lugar de tener que conectarse al Shell de Render.
#
# Si están vacíos, el panel responde pero rechaza todos los logins. No
# se ejecuta ninguna lógica de auth contra estas vars cuando faltan.
#
# Recomendación: en producción, usá un email distinto del de un usuario
# normal del cliente para evitar confusiones, y una contraseña fuerte
# (16+ chars). La sesión es cookie httponly samesite=lax con TTL 4 hs.
ADMIN_EMAIL=
ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
#  Base de datos  [licensing_api]
# -----------------------------------------------------------------------------

# Cadena SQLAlchemy. Para dev local: SQLite. En producción usar Postgres.
# Ej. Postgres: postgresql+psycopg2://user:pass@host:5432/dbname
LICENSE_DB_URL=sqlite:///./licensing_api.db


# -----------------------------------------------------------------------------
#  CORS  [licensing_api]
# -----------------------------------------------------------------------------

# Lista de orígenes permitidos, separados por coma. Default: solo localhost.
# Ej. producción: https://sri-robot-audit-ik01.onrender.com,https://admin.miempresa.com
# Usar "*" sólo si entendés el riesgo (deshabilita allow_credentials).
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501


# -----------------------------------------------------------------------------
#  Updates del .exe  [licensing_api, launcher, app, scripts]
# -----------------------------------------------------------------------------

# Token compartido entre server y .exe para autenticar requests a /updates/*.
# Si lo dejas VACIO, /updates/download y /updates/latest quedan publicos —
# util si distribuis el .exe desde una landing publica (audit-ia.ec). El
# bot desktop sigue funcionando: manda el token via X-Update-Token pero
# el server lo ignora cuando esta vacio.
#
# Generarlo: python -c "import secrets; print(secrets.token_urlsafe(32))"
UPDATE_TOKEN=

# URL base del servicio de licencias. La consumen el launcher y la app.
LICENSE_API_URL=https://sri-robot-audit-ik01.onrender.com

# Override opcional del endpoint de updates. Si no se setea, se construye
# como ${LICENSE_API_URL}/updates/latest.
# UPDATE_URL=

# Token embebido en el .exe al hacer build. Solo se evalúa por PyInstaller
# cuando se ejecuta build_desktop.bat. Si querés mantener el .exe libre de
# secretos, dejalo vacío y poné UPDATE_TOKEN en desktop_config.json.
DEFAULT_UPDATE_TOKEN=

# URL del licensing api por defecto si el launcher no encuentra config.
DEFAULT_LICENSE_API_URL=https://sri-robot-audit-ik01.onrender.com

# Metadatos del release publicado.
# Si están seteados en el server, el endpoint /updates/latest devuelve esta info.
#
# UPDATE_FILE_URL es la fuente del .exe — PRIORIDAD:
#   1) UPDATE_FILE_URL  → el endpoint /updates/download hace REDIRECT 302 a
#      esta URL. RECOMENDADO con GitHub Releases:
#      https://github.com/<owner>/<repo>/releases/download/v1.0.0/ROBOT_AUDIT_SRI.exe
#      Ventaja: el cliente baja del CDN de GitHub, no consume bandwidth de Render.
#   2) UPDATE_FILE_PATH → archivo en disco persistente de Render.
#   3) Cloudflare R2 (legacy, ver bloque R2_* mas abajo).
# UPDATE_VERSION=1.2.3
# UPDATE_SHA256=
# UPDATE_SIZE=
# UPDATE_FILE_URL=https://github.com/<owner>/<repo>/releases/download/v1.0.0/ROBOT_AUDIT_SRI.exe
# UPDATE_FILE_PATH=
# LANDING_LOGO_PATH=           # Logo opcional en la landing de updates

# URL del manual de usuario (PDF). Si esta seteado, /manual hace REDIRECT
# 302 a esta URL. Mismo patron que UPDATE_FILE_URL: subir el PDF como
# asset en GitHub Releases y pegar la URL aqui. Permite actualizar el
# manual sin redeploy del Render.
# Si no esta seteado, /manual busca MANUAL_USUARIO.pdf en la raiz del
# proyecto (fallback legacy — para que funcione necesitas commitear el
# PDF al repo y redeployar).
# MANUAL_URL=https://github.com/<owner>/<repo>/releases/download/v1.0.0/MANUAL_USUARIO.pdf


# -----------------------------------------------------------------------------
#  SMTP — reset de password  [licensing_api]
# -----------------------------------------------------------------------------

# Si no se configura, el flujo de password reset escribe el link a un JSON
# local en lugar de mandar email (útil en dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente del email. Si está vacío, se usa SMTP_USER.
SMTP_FROM=
# STARTTLS. Poner "0" sólo si usás SMTP_SSL en puerto 465.
SMTP_USE_TLS=1

# Duración del token de reset (segundos). Mínimo 300.
RESET_TOKEN_TTL=3600

# URL base para construir el link del email. Si está vacío se deduce de
# x-forwarded-* o cae a APP_BASE_URL.
RESET_LINK_BASE_URL=

# URL base de la app (usada por reset y otras). Si está vacío, se deduce de
# los headers x-forwarded-proto / x-forwarded-host del primer request.
APP_BASE_URL=


# -----------------------------------------------------------------------------
#  Cloudflare R2 — storage del .exe de updates (LEGACY)  [licensing_api, scripts]
# -----------------------------------------------------------------------------
# RECOMENDADO: usar UPDATE_FILE_URL apuntando a GitHub Releases (ver bloque
# de arriba). Esta seccion R2_* queda solo como fallback historico — el codigo
# lo sigue soportando pero solo si UPDATE_FILE_URL y UPDATE_FILE_PATH estan
# vacios. Si arrancas el proyecto desde cero, podes IGNORAR este bloque entero.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Si está vacío, se construye como https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
# Nombre del archivo dentro del bucket.
R2_OBJECT_KEY=ROBOT_AUDIT_SRI.exe
# TTL de la presigned URL devuelta a los clientes (segundos).
R2_URL_EXPIRES=900
# Cache-Control que se setea al subir el .exe (sólo lo usa publish_update.py).
R2_CACHE_CONTROL=


# -----------------------------------------------------------------------------
#  Playwright  [robot, app]
# -----------------------------------------------------------------------------

# 1 = headless (sin UI). En Render se fuerza automáticamente.
# 0 = con UI (usado al correr en escritorio).
PLAYWRIGHT_HEADLESS=1

# Dónde Playwright guarda los binarios de Chromium.
# OJO: en Render esto está definido también en render.yaml (/ms-playwright)
# y SOBREESCRIBE este default. Mantener ambos coherentes.
PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright

# Salta la descarga (cuando los binarios ya están en la imagen Docker).
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Ralentiza acciones en ms — útil para depurar.
PLAYWRIGHT_SLOWMO=0

# Abre DevTools junto con el navegador.
PLAYWRIGHT_DEVTOOLS=0

# Reutilizar un perfil de Chromium entre ejecuciones (cookies, login).
PLAYWRIGHT_PERSISTENT_PROFILE=1
PLAYWRIGHT_USER_DATA_DIR=browser_profile

# Preferir Chrome del sistema sobre Chromium bundled de Playwright. La app de
# referencia que pasa el captcha del SRI sin problemas usa Chrome 148 del
# sistema; Chromium bundled suele estar varias versiones atrás (~127) y a
# reCAPTCHA Enterprise no le gusta. Si tu PC no tiene Chrome instalado, el
# bot cae automáticamente al Chromium bundled. Si por algún motivo este
# cambio rompe algo en Emitidos, podés volver al comportamiento previo con:
#   PREFER_SYSTEM_CHROME=0
PREFER_SYSTEM_CHROME=1


# -----------------------------------------------------------------------------
#  Logging  [robot]
# -----------------------------------------------------------------------------

# Nivel del logger del paquete robot.* (configurado en robot/_logging.py).
# Valores: DEBUG, INFO, WARNING, ERROR, CRITICAL (o número 10–50).
ROBOT_LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
#  Robot SRI — Recibidos  [robot]
# -----------------------------------------------------------------------------

# Si "1", se pausa para que el operador resuelva el captcha a mano.
RECIBIDOS_MANUAL_CONSULTA=0

# Reintentos automáticos al consultar el portal.
RECIBIDOS_CONSULTA_INTENTOS=5

# Base del backoff exponencial entre reintentos (segundos).
RECIBIDOS_CONSULTA_BACKOFF_BASE_SEC=1.2

# Delays alrededor del clic en "Consultar" (ms).
RECIBIDOS_AUTO_PRE_EXECUTE_MS=450
RECIBIDOS_AUTO_POST_EXECUTE_MS=300

# Timeout para que aparezcan los resultados (ms).
RECIBIDOS_AUTO_RESULT_TIMEOUT_MS=60000

# Timeout esperando el token de reCAPTCHA (ms).
RECIBIDOS_RECAPTCHA_TOKEN_TIMEOUT_MS=10000

# Desde qué intento rehidratar la sesión (mínimo 2).
RECIBIDOS_REHIDRATAR_DESDE_INTENTO=3

# Rehidratar sesión cuando aparece captcha.
RECIBIDOS_REHIDRATAR_ON_CAPTCHA=1


# -----------------------------------------------------------------------------
#  Robot SRI — Emitidos  [robot]
# -----------------------------------------------------------------------------

# Cuántos comprobantes por día procesar antes de resetear la sesión.
EMITIDOS_RESET_AFTER_DAY_DOCS=51

# Pausa antes de hacer el reset (ms).
EMITIDOS_RESET_PAUSE_MS=1800


# -----------------------------------------------------------------------------
#  Robot SRI — Login y descarga  [robot]
# -----------------------------------------------------------------------------

# Timeout total para descargas de comprobantes (ms).
SRI_DOWNLOAD_TIMEOUT_MS=120000

# Reintentos al fallar la descarga de una fila.
DOWNLOAD_ROW_RETRY_ATTEMPTS=2

# Pausas opcionales para debugging del flujo de login.
PAUSE_BEFORE_INGRESAR=0
# PAUSE_BEFORE_INGRESAR_PROMPT="Pausa antes de hacer clic en 'Ingresar'..."
PAUSE_BEFORE_CONSULTAR=0
PAUSE_BEFORE_CONSULTAR_SECONDS=0


# -----------------------------------------------------------------------------
#  Captcha  [robot]
# -----------------------------------------------------------------------------
# El proyecto NO usa servicios externos para resolver captcha (se eliminó la
# integración con 2Captcha). Todos los captchas (imagen + reCAPTCHA) se
# resuelven manualmente por el usuario en la ventana del navegador.
#
# Si querés que el bot pause en la pantalla de Recibidos para que el usuario
# haga clic manual en "Consultar" y resuelva el reCAPTCHA por sí mismo (modo
# útil cuando Google rechaza la automatización), activá:
RECIBIDOS_MANUAL_CONSULTA=0

# Recibidos (reCAPTCHA invisible / Enterprise) — knobs de robustez.
# Cantidad máxima de intentos automáticos antes de mostrar el aviso final.
RECIBIDOS_CONSULTA_INTENTOS=5
# Tiempo máximo (ms) para esperar que Google emite un token nuevo después
# de disparar la consulta. Si se excede, se considera fallido el intento.
RECIBIDOS_RECAPTCHA_TOKEN_TIMEOUT_MS=10000
# Backoff base (segundos) entre intentos; el flujo lo multiplica por el N° de intento.
RECIBIDOS_CONSULTA_BACKOFF_BASE_SEC=0.5
# Desde qué intento se hace recarga "completa" de la página para regenerar el
# entorno de reCAPTCHA si Google sigue rechazando.
RECIBIDOS_REHIDRATAR_DESDE_INTENTO=3
RECIBIDOS_REHIDRATAR_ON_CAPTCHA=1

# ─── HUMANIZACIÓN ELIMINADA (2026-05-29) ────────────────────────────────────
# Probamos múltiples variantes de pre-interacción "humana" antes del click
# (mouse moves con steps, clicks blancos automáticos, pausas largas) y
# NINGUNA mejoró el score de reCAPTCHA Enterprise. Los eventos sintéticos
# de Playwright tienen timing demasiado uniforme y Google los detecta como
# bots. Lección: cero signals > signals robóticos.
#
# Si necesitás replicar la receta de la app de referencia que pasa el captcha
# al primer intento, usá una o ambas de las opciones de abajo:

# WARMUP PASIVO en la página de perfil del SRI. Confirmamos en pruebas que
# la app de referencia mantiene Chrome abierto en srienlinea.sri.gob.ec por
# minutos antes del primer click (el usuario configura filtros en su UI).
# reCAPTCHA Enterprise acumula signals positivos durante ese tiempo en
# dominio y arranca con score más alto.
#
# Si =0 (default), no hace warmup. Si >0, después del login el bot navega a
# /sri-en-linea/contribuyente/perfil y espera ese tiempo antes de ir a
# Recibidos. Se aplica UNA SOLA VEZ por sesión del bot (las consultas
# subsiguientes — otros meses/tipos — no repiten el warmup).
# Valor sugerido para probar: 30000-60000 (30-60 segundos).
RECIBIDOS_PERFIL_WARMUP_MS=0

# PERFIL TEMPORAL POR SESIÓN. La app de referencia usa
# `--user-data-dir=...\Temp\scoped_dir_XXXX` (perfil nuevo cada vez). Si
# nuestro perfil persistente tiene "mala reputación" acumulada en Google
# (intentos previos con --enable-automation activo), un perfil limpio puede
# ayudar.
#
# Si =1, en cada arranque del bot se crea un perfil temporal con
# `tempfile.mkdtemp("sri_robot_profile_")` y se usa como user-data-dir.
# El usuario tiene que loguearse al SRI cada vez que arranca el bot
# (fricción mayor) pero arranca con cookies vacías sin mala reputación.
# Si =0 (default), usa el perfil persistente normal (browser_profile/).
PLAYWRIGHT_USE_TEMP_PROFILE=0


# -----------------------------------------------------------------------------
#  Streamlit  [app, launcher]
# -----------------------------------------------------------------------------

# Telemetría apagada por privacidad.
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Intervalo (segundos) entre `st.rerun()` durante una descarga activa para
# refrescar mensajes de progreso en la UI. Cada rerun produce un overlay
# oscuro momentáneo en Streamlit; bajar este valor hace la UI más "viva"
# pero parpadea más; subirlo da pantalla más estable pero el progreso se
# actualiza más despacio. Default 1.5s. Recomendado: 1.0-2.5.
STREAMLIT_REFRESH_SEC=1.5

# Las siguientes solo aplican cuando se arranca via desktop_launcher.py;
# Streamlit las setea internamente.
# STREAMLIT_SERVER_HEADLESS=true
# STREAMLIT_GLOBAL_DEVELOPMENT_MODE=false
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=127.0.0.1


# -----------------------------------------------------------------------------
#  Desktop Launcher  [launcher, app]
# -----------------------------------------------------------------------------

# Activa/desactiva el chequeo y aplicación de updates dentro del .exe.
UPDATE_IN_APP=1

# Cache de sesión (cookies, perfil de navegador).
ENABLE_SESSION_CACHE=1
SESSION_CACHE_DIR=.session_cache
# USER_PREFS_PATH=<derivado de SESSION_CACHE_DIR>/user_prefs.json


# -----------------------------------------------------------------------------
#  Scripts de release  [scripts]
# -----------------------------------------------------------------------------
# Usados por scripts/publish_update.py para subir un nuevo .exe a R2 y
# disparar el redeploy de Render.

# Token de la API de Render (Settings → API Keys).
RENDER_API_KEY=

# ID del servicio que se actualiza (Render dashboard → service → Settings).
RENDER_SERVICE_ID=

# Dispara redeploy automático tras el update.
RENDER_TRIGGER_DEPLOY=1
